{{define "pages/admin/index"}}
{{template "dashboard/header" .}}
{{template "dashboard/navbar" .}}
{{template "dashboard/sidebar" .}}
<div id="main-column" class="container-fluid" role="main">
  <h2>{{.Title}} <a class="btn btn-primary" href="/admin/new_page">Новая страница</a></h2>
  <table class="table">
    <thead>
      <tr>
        <th class="id">№</th>
        <th class="name">Название</th>
        <th class="published">Опубиковано</th>
        <th class="actions">Действия</th>
      </tr>
    </thead>
    <tbody>
      {{$csrfField := .csrfField}}
      {{range .List}}
        <tr>
          <td class="id">{{.ID}}</td>
          <td class="name">{{.Name}}</td>
          <td class="published">
            {{if .Published}}Да{{else}}Нет{{end}}
          </td>
          <td class="actions">
            <a href="{{.URL}}" class="btn btn-sm btn-default">{{template "eye_svg"}}</a>
            <a href="/admin/edit_page/{{.ID}}" class="btn btn-sm btn-primary">{{template "pen_svg"}}</a>
            <form class="inline-block" action="/admin/delete_page" method="post">
              {{$csrfField}}
              <input type="hidden" name="id" value="{{.ID}}">
              <button type="button" class="btn btn-sm btn-danger" onclick="((confirm('Вы уверены?')) ? this.form.submit() : null);">{{template "cross_svg"}}</button>
            </form>
          </td>
        </tr>
      {{end}}
    </tbody>
  </table>
  <div class="actions">
    <a href="/admin/new_page" class="btn btn-primary">Новая страница</a>
  </div>
</div>
{{template "dashboard/footer" .}}
{{end}}
