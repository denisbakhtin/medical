{{define "navbar"}}
{{template "navbar_scroll" .}}
<div id="header-top">
  <a id="logo" href="/">
    <img src="/public/images/logo.png" alt="Кинезиология Миобаланс, г. Москва">
    <div class="logo-text pull-right">
      <p id="name" class="text-success">миобаланс</p>
      <p class="text-muted">Прикладная кинезиология</p>
    </div>
  </a>
  <div class="header-cta hidden-xs">
    <a class="btn btn-primary d-inline-flex align-items-center" href="#optin-form"><span class="svg svg-white lh-1 me-2">{{template "check_svg" .}}</span>Записаться на бесплатную консультацию</a>
    <p class="text-warning lowercase">акция действует {{promoTill}}</p>
  </div>
  <div id="header-phone">
    <p class="text-success phone nowrap">8 (903) 689-20-57</p>
    <p class="text-success hours nowrap">c 9:00 до 21:00 <a href="https://t.me/evgenyrost">t.me/evgenyrost</a></p>
  </div>
</div>

<!-- Hidden checkbox to track state -->
<input type="checkbox" id="navbar-toggle" class="d-none">
<div id="navbar-main" class="full-width navbar navbar-default" role="navigation">
  <div class="navbar-header">
    <label for="navbar-toggle" class="navbar-toggler">
      <span class="sr-only">Переключить меню</span>
      {{template "menu_svg" .}}
    </label>
    <div class="header-cta visible-xs">
      <a class="btn btn-primary d-inline-flex align-items-center" href="#optin-form"><span class="svg svg-white lh-1 me-2">{{template "check_svg" .}}</span>Бесплатная консультация</a>
    </div>
  </div>
  <div class="navbar-collapse collapse">
    <ul class="nav navbar-nav">
      {{$active := .Active}}
      {{range mainMenu}}
        {{- if len .Children | lt 0 -}}
          <li class="dropdown">
            <a href="{{.URL}}" class="dropdown-toggle disabled" data-toggle="dropdown" role="button">{{.Title}}</a>
            <ul class="dropdown-menu">
              {{range .Children}}
                <li><a href="{{.URL}}">{{.Title}}</a></li>
              {{end}}
            </ul>
          </li>
        {{else}}
          <li class="{{.CSSClass}} {{isActive $active .URL}}">
            <a href="{{.URL}}">{{.Title}}</a>
          </li>
        {{end}}
      {{end}}
      {{- if .Authenticated -}}
      <li>
        <a href="/admin/articles" class="strong">Админка</a>
      </li>
      <li>
        <a href="/logout" class="strong">Выйти</a>
      </li>
      {{end}}
    </ul>
  </div><!--/.nav-collapse -->
</div>

<section id="header-bottom" class="row full-width">
  <div class="col-sm-4 col-xs-12">
    <span class="svg svg-secondary lh-1 me-2 mb-2 pull-left me-4">{{template "plus_svg" .}}</span>
    <p class="strong">Высокая эффективность</p>
    <p>Сотни вылеченных пациентов и положительных отзывов</p>
  </div>
  <div class="col-sm-4 col-xs-12">
    <span class="svg svg-secondary lh-1 me-2 mb-2 pull-left me-4">{{template "tender_svg" .}}</span>
    <p class="strong">Мягкое лечение</p>
    <p>Применяем передовые техники лечения и минимум медикаментов</p>
  </div>
  <div class="col-sm-4 col-xs-12">
    <span class="svg svg-secondary lh-1 me-2 mb-2 pull-left me-4">{{template "promo_svg" .}}</span>
    <p class="strong">Акция!</p>
    <p>Первичная консультация <span class="strike-through">1000</span> 0&nbsp;руб. Первый сеанс <s>8000</s> 7000 руб.</p>
  </div>
</section>
{{end}}
