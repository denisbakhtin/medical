{{define "reviews/admin/index"}}
{{template "dashboard/header" .}}
{{template "dashboard/navbar" .}}
{{template "dashboard/sidebar" .}}
<div id="main-column" class="container-fluid" role="main">
  <h2>{{.Title}}</h2>
  <table class="table">
    <thead>
      <tr>
        <th class="id">№</th>
        <th class="author_name">Автор</th>
        <th class="author_email">Эл. почта</th>
        <th class="content">Текст отзыва</th>
        <th class="published">Опубликовано</th>
        <th class="actions">Действия</th>
      </tr>
    </thead>
    <tbody>
      {{$csrfField := .csrfField}}
      {{range .List}}
        <tr>
          <td class="id">{{.ID}}</td>
          <td class="author_name">{{.AuthorName}}</td>
          <td class="author_email">{{.AuthorEmail}}</td>
          <td class="content">{{.Excerpt}}</td>
          <td class="published">
            {{if .Published}}Да{{else}}Нет{{end}}
          </td>
          <td class="actions">
            <a href="/reviews/{{.ID}}" class="btn btn-sm btn-default">{{template "eye_svg"}}</a>
            <a href="/admin/edit_review/{{.ID}}" class="btn btn-sm btn-primary">{{template "pen_svg"}}</a>
            <form class="inline-block" action="/admin/delete_review" method="post">
              {{$csrfField}}
              <input type="hidden" name="id" value="{{.ID}}">
              <button type="button" class="btn btn-sm btn-danger" onclick="((confirm('Вы уверены?')) ? this.form.submit() : null);">{{template "cross_svg"}}</button>
            </form>
          </td>
        </tr>
      {{end}}
    </tbody>
  </table>
  
</div>
{{template "dashboard/footer" .}}
{{end}}
