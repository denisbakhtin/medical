{{define "comments/form"}}
  <section id="comment-form-wrapper">
    <h2 class="text-center">Задать вопрос кинезиологу</h2>
    <form method="post" action="/new_comment">
      <fieldset>
        {{.csrfField}}
        <input type="hidden" name="article_id" value="{{.Article.ID}}" >

        <div class="form-group">
          <textarea id="textarea-comment" class="form-control" name="content" required></textarea>
        </div>

        <div id="comment-hidden">
          <div class="row">
            <div class="form-group col-xs-12 col-sm-4">
              <label class="control-label" for="author_city">Ваш город</label>
              <select id="author_city" name="author_city" required="" class="form-control input-md">
                <option value="">Выберите город</option>
                {{range cityList}}
                <option value="{{.}}">{{.}}</option>
                {{end}}
              </select>
            </div>

            <div class="form-group col-xs-12 col-sm-4">
              <label class="control-label" for="author_name">Представьтесь</label>
              <input id="author_name" name="author_name" placeholder="Укажите ваше имя" required="" class="form-control input-md">
            </div>

            <div class="form-group col-xs-12 col-sm-4">
              <label class="control-label" for="author_email">Адрес эл. почты</label>
              <input type="email" id="author_email" name="author_email" placeholder="(останется в тайне)" class="form-control input-md">
            </div>
          </div>

          <div class="form-group">
            <label class="control-label">Подтвердите, что Вы не робот: передвиньте ползунок вправо до упора</label>
            <div id="captcha-comments-wrapper">
              <input type="range" min="0" max="100" value="30" class="slider" id="range-comment-captcha">
              <input type="hidden" id="captcha-comment" name="captcha">
            </div>
          </div>
        </div>

        <div class="form-group text-center">
          <input id="submit-with-captcha-comment-btn" type="submit" class="btn btn-primary btn-lg" disabled value="Отправить" >
        </div>
      </fieldset>
    </form>
  </section>
{{end}}
