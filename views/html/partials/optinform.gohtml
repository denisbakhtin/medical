{{define "optinform"}}
<section id="optin-form">
  <h2 class="clearfix text-center">Запишитесь на бесплатную консультацию</h2>
  <p class="text-center text-muted">Стоимость первого сеанса <s>8000</s> 7000 руб.<br> Акция действует {{promoTill}}.</p>
  <form class="panel panel-default" method="post" onsubmit="try{yaCounter19271005.reachGoal('ORDER', function(){}, null);} catch(e){}; return true;" action="/new_request">
    {{.csrfField}}
    <div class="panel-body row">
      <div class="form-group col-xs-12 col-sm-6">
        <label for="name-input">Ваше имя</label>
        <input id="name-input" class="form-control" name="name" required="">
      </div>
      <div class="form-group col-xs-12 col-sm-6">
        <label for="phone-input">Контактный телефон</label>
        <input id="phone-input" class="form-control" name="phone" placeholder="+7 (999) 999-99-99" maxlength="18" required="">
      </div>
      <div class="form-group col-xs-12">
        <label for="comment-textarea">Что Вас беспокоит, когда лучше перезвонить</label>
        <textarea id="comment-textarea" class="form-control" name="comment" placeholder="Дополнительная информация, которую Вы хотели бы сообщить врачу"></textarea>
      </div>
      <div class="form-group col-xs-12">
        <label class="control-label">Подтвердите, что Вы не робот: передвиньте ползунок вправо до упора</label>
        <div id="captcha-wrapper">
          <input type="range" min="0" max="100" value="30" class="slider" id="range-captcha">
          <input type="hidden" id="captcha" name="captcha">
        </div>
      </div>
      <div class="actions col-xs-12">
        <input id="submit-with-captcha-btn" type="submit" class="btn btn-primary" disabled value="Отправить">
      </div>      
    </div>
  </form>
</section>
{{end}}
