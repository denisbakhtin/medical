{{define "testimonials"}}

  {{- if .Testimonials -}}
    {{template "reviews" .Testimonials}}
  {{else}}
    {{template "reviews" allReviews}}
  {{end}}

{{end}}

{{define "reviews"}}
  <section id="testimonials">
    <h2 class="text-center">Отзывы пациентов</h2>
    <p>Эффективность и качество применяемых на практике врачом кинезиологом методик подтверждено многочисленными положительными отзывами.</p>

    <div id="testimonials-slider-wrapper">
      <div id="testimonials-slider">
        {{range $i, $v := .}}
          <div class="item">
            <a class="thumbnail" href="{{.URL}}">
              {{- if .Image}}
                <img class="img img-responsive" src="{{.Image}}" loading="lazy" alt="{{.Complaint}}">
              {{else}}
                <div class="img blank-review-img">{{truncate .AuthorName 1}}</div>
              {{end}}
              <div class="text-wrapper">
                {{- if .Complaint}}
                  <h4>{{.Complaint}}</h4>
                {{end}}
                <p class="strong">{{.AuthorName}}</p>
                <p class="excerpt">{{.Excerpt}}</p>
              </div>
            </a>
          </div>
        {{end}}
      </div>
      <div class="siema-controls">
        <span class="testimonials-prev">
          <span class="svg svg-secondary lh-1">{{template "chevron_left_svg" .}}</span>
        </span>
        <span class="testimonials-next">
          <span class="svg svg-secondary lh-1">{{template "chevron_right_svg" .}}</span>
        </span>
      </div>
    </div>
  </section>
{{end}}
