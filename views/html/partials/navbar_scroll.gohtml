{{define "navbar_scroll"}}
<div id="navbar-scroll" class="navbar navbar-default navbar-fixed-top">
  <ul class="nav navbar-nav">
    {{range scrollMenu}}
    <li class="{{.CSSClass}}">
      <a href="{{.URL}}">{{.Title}}</a>
    </li>
    {{end}}
    <li>
      <p class="navbar-text">
      <a class="btn btn-primary d-inline-flex align-items-center lh-1 hidden-xs" href="#optin-form"><span class="svg svg-white lh-1 me-2">{{template "check_svg" .}}</span>Записаться на бесплатную консультацию</a>
      </p>
    </li>
  </ul>
</div>
{{end}}
